# Everything the Neovim/AstroNvim setup needs. Install with: brew bundle --file ~/dotfiles/Brewfile

# Editor + core tools
brew "neovim"
brew "git"
brew "ripgrep"          # live grep (Space fw)
brew "lazygit"          # git UI (Space gg)
brew "tree-sitter-cli"  # builds treesitter parsers
brew "bottom"           # system monitor (Space tt)
brew "gdu"              # disk usage (Space tu), installed as gdu-go

# Language toolchains (language servers are installed by Mason inside Neovim)
brew "node"             # JS/TS/Vue + many Mason servers
brew "python"           # Python 3
brew "go"               # Go + building gopls and Go tools
brew "rustup"           # Rust (keg-only, see zsh/toolchains.zsh)
brew "openjdk@21"       # Java 21 for jdtls (keg-only, see zsh/toolchains.zsh)

# Font with icons, set it in your terminal
cask "font-jetbrains-mono-nerd-font"
